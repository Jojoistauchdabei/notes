{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Federwerk-Notizbuch (federwerk-1)",
  "description": "Exportformat der Federwerk-Handschrift-App. Gesamt-Export {books,folders,openBookId,openPageId} oder Einzelbuch {id,title,...,pages}. Canvas: 1000x1414 px. Menschenlesbare Doku: FEDERWERK_FORMAT.md, Einstieg für LLMs: llms.txt.",
  "type": "object",
  "anyOf": [
    { "$ref": "#/$defs/collectionExport" },
    { "$ref": "#/$defs/bookExport" }
  ],
  "$defs": {
    "formatMeta": {
      "type": "object",
      "description": "KI-lesbare Format-Metadaten (Aufgabe 5, gesetzt via js/format-doc.js).",
      "properties": {
        "$schema": { "type": "string" },
        "formatVersion": { "const": "federwerk-1" },
        "formatDoc": { "type": "string" },
        "_ai": {
          "type": "object",
          "required": ["format", "version", "fields", "promptHint"],
          "properties": {
            "format": { "const": "federwerk-notebook" },
            "version": { "const": "federwerk-1" },
            "schema": { "type": "string" },
            "doc": { "type": "string" },
            "fields": { "type": "object" },
            "promptHint": { "type": "string" }
          }
        }
      }
    },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "description": "Canvas-px, 0..1000" },
        "y": { "type": "number", "description": "Canvas-px, 0..1414" },
        "p": { "type": "number", "minimum": 0, "maximum": 1, "description": "Stift-Druck, optional (Default 0.5)" }
      }
    },
    "stroke": {
      "type": "object",
      "required": ["points"],
      "properties": {
        "tool": { "enum": ["pen", "marker", "eraser"] },
        "color": { "type": "string" },
        "size": { "type": "number" },
        "alpha": { "type": "number" },
        "points": { "type": "array", "items": { "$ref": "#/$defs/point" } },
        "closed": { "type": "boolean" },
        "fill": { "type": ["string", "null"] },
        "fillAlpha": { "type": "number" },
        "dash": { "type": "array", "items": { "type": "number" } },
        "highlighter": { "type": "boolean" }
      }
    },
    "textBox": {
      "type": "object",
      "required": ["html"],
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "number", "description": "Normiert 0..1 relativ zur Seitenbreite" },
        "y": { "type": "number", "description": "Normiert 0..1 relativ zur Seitenhöhe" },
        "html": { "type": "string", "description": "Getippter Rich-Text (h1/h2/b/i/u/listen, inline style)" }
      }
    },
    "image": {
      "type": "object",
      "required": ["src"],
      "properties": {
        "id": { "type": "string" },
        "x": { "type": "number", "description": "Normiert 0..1" },
        "y": { "type": "number", "description": "Normiert 0..1" },
        "w": { "type": "number", "description": "Normiert 0..1 (Höhe aus Seitenverhältnis)" },
        "src": { "type": "string", "description": "dataURL (data:image/...) oder App-interne blob:-URL" }
      }
    },
    "page": {
      "type": "object",
      "required": ["strokes", "texts", "images"],
      "properties": {
        "id": { "type": "string" },
        "strokes": { "type": "array", "items": { "$ref": "#/$defs/stroke" } },
        "texts": { "type": "array", "items": { "$ref": "#/$defs/textBox" } },
        "images": { "type": "array", "items": { "$ref": "#/$defs/image" } },
        "bg": { "type": ["string", "null"], "description": "Seiten-Hintergrund als Bild-dataURL oder null" },
        "size": {
          "type": ["object", "null"],
          "description": "Seitenformat in Canvas-px (gesetzt vom Papiervorlagen-Wechsel, Bild-/PDF-Import oder Seitenformat-Wahl). Fehlt = A4-Hoch-Default (1000x1414), wird nicht persistiert.",
          "properties": {
            "w": { "type": "number" },
            "h": { "type": "number" }
          }
        },
        "size": {
          "type": ["object", "null"],
          "description": "Optionales Seitenformat in Canvas-Einheiten (fehlt/null = A4-Hoch 1000×1414)",
          "properties": {
            "w": { "type": "number", "minimum": 200, "maximum": 2400 },
            "h": { "type": "number", "minimum": 200, "maximum": 2400 }
          },
          "required": ["w", "h"]
        }
      }
    },
    "card": {
      "type": "object",
      "description": "Karteikarte (nur bei book.kind='flashcards', js/flashcards.js, SM-2-Lernsystem).",
      "required": ["front", "back"],
      "properties": {
        "id": { "type": "string" },
        "front": { "type": "string", "description": "Vorderseite (Frage, Plain-Text oder HTML light)" },
        "back": { "type": "string", "description": "Rückseite (Antwort)" },
        "frontImg": { "type": ["string", "null"], "description": "Optionales Bild vorne (dataURL oder blob:-Ref)" },
        "backImg": { "type": ["string", "null"], "description": "Optionales Bild hinten (dataURL oder blob:-Ref)" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "ease": { "type": "number", "description": "SM-2-Ease-Faktor (1.3..2.8, Start 2.5)" },
        "interval": { "type": "number", "description": "Intervall in Tagen (0 = in ~10 Min fällig)" },
        "reps": { "type": "number", "description": "Aufeinanderfolgende korrekte Wiederholungen" },
        "lapses": { "type": "number", "description": "Anzahl Nochmal-Fehler" },
        "due": { "type": "number", "description": "Nächste Fälligkeit (ms seit Epoch)" },
        "lastReview": { "type": ["number", "null"], "description": "Letzte Bewertung (null = neue Karte)" },
        "suspended": { "type": "boolean" },
        "totalReviews": { "type": "number" },
        "correctReviews": { "type": "number" }
      }
    },
    "deckOptions": {
      "type": "object",
      "description": "Tages-Limits eines Karteikarten-Decks.",
      "properties": {
        "newPerDay": { "type": "number" },
        "maxReviewsPerDay": { "type": "number" }
      }
    },
    "folder": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "parentId": { "type": ["string", "null"] },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "book": {
      "type": "object",
      "required": ["pages"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "kind": { "type": "string", "enum": ["notebook", "flashcards"], "description": "Dokumenttyp: 'notebook' (Default, Feld darf fehlen) oder 'flashcards' (Karteikarten-Deck mit cards[] + SM-2-Lernsystem, js/flashcards.js)." },
        "cards": { "type": "array", "items": { "$ref": "#/$defs/card" }, "description": "Karteikarten (nur bei kind='flashcards')." },
        "deckOptions": { "$ref": "#/$defs/deckOptions" },
        "paper": { "type": "string", "description": "Papiervorlagen-ID, Buch-weit (Design + Maße, Katalog: js/paper-templates.js, z. B. blank-a4, lined-a4, grid-a4, dots-a4, cornell-a4). Legacy '' | 'lined' | 'grid' mappen auf blank-a4 | lined-a4 | grid-a4." },
        "updatedAt": { "type": "number" },
        "folderId": { "type": ["string", "null"], "description": "Ordner-ID oder null (= Unsortiert)" },
        "lang": { "type": "string" },
        "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } }
      }
    },
    "collectionExport": {
      "allOf": [
        { "$ref": "#/$defs/formatMeta" },
        {
          "type": "object",
          "required": ["books"],
          "properties": {
            "books": { "type": "array", "items": { "$ref": "#/$defs/book" } },
            "folders": { "type": "array", "items": { "$ref": "#/$defs/folder" } },
            "openBookId": { "type": ["string", "null"] },
            "openPageId": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "bookExport": {
      "allOf": [
        { "$ref": "#/$defs/formatMeta" },
        { "$ref": "#/$defs/book" }
      ]
    }
  }
}
